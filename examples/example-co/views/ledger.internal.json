{
  "system": "ledger",
  "audience": "internal",
  "platforms": [
    "shared-hosting"
  ],
  "providers": [
    "example-cloud",
    "example-cdn",
    "example-git"
  ],
  "included": [
    {
      "manifest": "ledger-govulncheck.manifest.json",
      "tool": "govulncheck",
      "via": "system"
    },
    {
      "manifest": "platform-benchmark.manifest.json",
      "tool": "powerpipe",
      "via": "platform:shared-hosting"
    },
    {
      "manifest": "platform-db-roles.manifest.json",
      "tool": "db-role-export",
      "via": "platform:shared-hosting"
    },
    {
      "manifest": "platform-host-scan.manifest.json",
      "tool": "oscap",
      "via": "platform:shared-hosting"
    },
    {
      "manifest": "platform-proxy-config.manifest.json",
      "tool": "proxy-config-export",
      "via": "platform:shared-hosting"
    }
  ],
  "withheld": []
}
